      "id": "549519ce-88d2-566f-bc3d-f0c6287a276e",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.4",
      "title": "Data minimisation",
      "description": "The cloud service provider shall anonymise, pseudonymise, or aggregate PII where full identification is not required for the processing purpose. Anonymisation and pseudonymisation techniques shall be documented and reviewed for effectiveness.",
      "level": 1,
      "sort_order": 500,
      "metadata": {
        "maps_to_iso27001_2022": [
          "A.5.34",
          "A.8.24"
        ],
