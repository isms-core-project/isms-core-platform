      "id": "d557eddd-f59f-5245-b494-b2e91162e4c8",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.10.1",
      "title": "Information security obligations for sub-processors",
      "description": "The cloud service provider shall ensure that any sub-processors engaged to process PII provide equivalent security guarantees to those required by the PII controller. Sub-processor agreements shall impose data protection obligations at least equivalent to the main contract.",
      "level": 1,
      "sort_order": 1100,
      "metadata": {
