      "id": "cc29ca60-1c92-5db2-853b-7fcbe8684d57",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.10.4",
      "title": "Encryption and key management for PII",
      "description": "PII shall be encrypted in transit using TLS 1.2 or higher. PII at rest shall be encrypted using approved cryptographic algorithms. Encryption keys for PII shall be managed separately from encrypted data. Key management procedures shall address generation, distribution, storage, rotation, and destruction.",
      "level": 1,
