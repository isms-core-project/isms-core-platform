      "id": "517790b7-f3f0-5ae7-b18a-f5c48b05ceaa",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.5",
      "title": "Use, retention, and disclosure limitation",
      "description": "PII shall be retained only for as long as necessary for the specified purpose. Retention schedules shall be documented and enforced. PII shall be disclosed only to authorised parties. Third-party disclosures shall be documented and restricted to the minimum necessary.",
      "level": 1,
      "sort_order": 600,
      "metadata": {
