      "id": "1ad25121-6204-5ba4-a1a3-00584f096dfd",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.8",
      "title": "Individual participation and access",
      "description": "The cloud service provider shall provide mechanisms to the PII controller to support fulfilment of data subject access requests (DSAR). Response capabilities shall be tested and documented. The provider shall assist the controller in responding to DSARs within statutory timeframes.",
      "level": 1,
      "sort_order": 900,
      "metadata": {
