    },
    {
      "type": "framework_control",
      "id": "d595dea8-ea75-5732-ada4-ff3070a2b65d",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.2",
      "title": "Purpose legitimacy and specification",
      "description": "The cloud provider shall process PII only for the purposes specified in the contract with the PII controller. Any proposed new processing purpose shall be documented and approved by the PII controller prior to implementation.",
      "level": 1,
      "sort_order": 300,
      "metadata": {
        "maps_to_iso27001_2022": [
          "A.5.34"
        ],
        "gdpr_ref": [
