      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.10.5",
      "title": "Access control for PII",
      "description": "Access to PII shall be restricted to personnel with a documented need to process it. All access to PII shall be logged. Privileged access to PII systems shall require additional authorisation. Access rights shall be reviewed at least quarterly.",
      "level": 1,
      "sort_order": 1500,
