      "id": "f80a07b3-312b-5790-a8d9-66fb586ace4b",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.6",
      "title": "Accuracy and quality",
      "description": "The cloud service provider shall implement controls to maintain the accuracy and completeness of PII. Mechanisms shall be provided to allow the PII controller to correct, update, or delete inaccurate PII. Quality checks shall be performed on PII stored or processed.",
      "level": 1,
      "sort_order": 700,
      "metadata": {
        "maps_to_iso27001_2022": [
