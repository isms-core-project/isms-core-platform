      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.10.3",
      "title": "Incident response for PII breaches",
      "description": "The cloud service provider shall notify the PII controller of PII breaches without undue delay (within 24 hours of discovery is best practice). Notifications shall include: categories and approximate number of data subjects affected, categories of PII affected, and initial assessment of impact.",
      "level": 1,
