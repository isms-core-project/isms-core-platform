      "id": "74e5b126-5b73-562a-88d9-703faf8e59f6",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.9",
      "title": "Accountability",
      "description": "The cloud service provider shall maintain records of all PII processing activities including: categories of PII, purposes, recipients, retention periods, and security measures. These records shall be made available to the PII controller and competent supervisory authorities upon request.",
      "level": 1,
      "sort_order": 1000,
      "metadata": {
