      "id": "9629bb33-abbd-54a1-b66e-28c3ab880d21",
      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.7",
      "title": "Openness, transparency, and notice",
      "description": "The cloud service provider shall make available to the PII controller information about the geographic location of data processing, applicable sub-processors, and any changes to processing. Privacy notices shall be maintained and kept current.",
      "level": 1,
      "sort_order": 800,
      "metadata": {
        "maps_to_iso27001_2022": [
          "A.5.34"
        ],
