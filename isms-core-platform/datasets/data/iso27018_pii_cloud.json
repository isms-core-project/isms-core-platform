      "framework_id": "107e4632-8cb8-5150-884b-0db1bb372f3e",
      "control_id": "A.10.2",
      "title": "Business continuity for PII",
      "description": "Business continuity plans shall include specific provisions for PII. Recovery time objectives for systems processing PII shall be defined. PII backup and recovery procedures shall be tested regularly.",
      "level": 1,
      "sort_order": 1200,
      "metadata": {
