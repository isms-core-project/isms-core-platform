{
  "index_patterns": ["connector-runs-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": "__REPLICAS__",
      "plugins.index_state_management.policy_id": "connector-runs-retention"
    },
    "mappings": {
      "properties": {
        "org_id":          {"type": "keyword"},
        "connector_id":    {"type": "keyword"},
        "connector_type":  {"type": "keyword"},
        "run_id":          {"type": "keyword"},
        "started_at":      {"type": "date"},
        "finished_at":     {"type": "date"},
        "status":          {"type": "keyword"},
        "records_fetched": {"type": "integer"},
        "records_indexed": {"type": "integer"},
        "errors":          {"type": "integer"},
        "duration_ms":     {"type": "long"},
        "error_detail":    {"type": "text"}
      }
    }
  }
}
