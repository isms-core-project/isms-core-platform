{
  "index_patterns": ["evidence-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": "__REPLICAS__",
      "plugins.index_state_management.policy_id": "evidence-retention"
    },
    "mappings": {
      "properties": {
        "org_id":          {"type": "keyword"},
        "connector_id":    {"type": "keyword"},
        "resource_id":     {"type": "keyword"},
        "evidence_type":   {"type": "keyword"},
        "control_ids":     {"type": "keyword"},
        "collected_at":    {"type": "date"},
        "valid_from":      {"type": "date"},
        "valid_to":        {"type": "date"},
        "title":           {"type": "text", "analyzer": "standard"},
        "summary":         {"type": "text", "analyzer": "standard"},
        "payload":         {"type": "object", "enabled": false},
        "file_refs":       {"type": "keyword"},
        "tags":            {"type": "keyword"},
        "status":          {"type": "keyword"},
        "gap_id":          {"type": "keyword"},
        "score":           {"type": "float"}
      }
    }
  }
}
