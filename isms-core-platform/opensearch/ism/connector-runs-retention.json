{
  "policy": {
    "description": "ISMS CORE connector run history — operational data only, short retention. Hot 30d → Delete after 90d. Extend for compliance connectors if run history is treated as audit evidence.",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {"index_priority": {"priority": 75}},
          {"rollover": {"min_index_age": "30d", "min_size": "5gb"}}
        ],
        "transitions": [
          {"state_name": "delete", "conditions": {"min_index_age": "90d"}}
        ]
      },
      {
        "name": "delete",
        "actions": [{"delete": {}}],
        "transitions": []
      }
    ],
    "ism_template": [
      {"index_patterns": ["connector-runs-*"], "priority": 100}
    ]
  }
}
