# Redirect all HTTP → HTTPS
server {
    listen ${NGINX_HTTP_PORT};
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen ${NGINX_HTTPS_PORT} ssl;
    server_name ${NGINX_HOST} _;

    # ── Docker DNS resolver — forces re-resolution on container restart ──────
    # Without this, nginx caches the backend IP at startup and breaks when
    # the backend container is recreated (new IP assigned by Docker).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend  http://isms-core-backend:8000;
    set $frontend http://isms-core-frontend:80;

    # ── TLS ─────────────────────────────────────────────────────────────────
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ── Security headers ─────────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains"                                                     always;
    add_header X-Frame-Options           SAMEORIGIN                                                                                always;
    add_header X-Content-Type-Options    nosniff                                                                                   always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"                                                         always;
    # CSP: unsafe-inline required by Angular Material (dynamic styles); unsafe-eval removed (not needed for production build)
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    client_max_body_size 50m;

    # ── Block API docs in production (FastAPI also disables them when debug=False) ──
    # Exact match only — avoids blocking /docs/* static files (e.g. /docs/user-manual.md)
    location ~ ^/(docs|redoc|openapi\.json)$ {
        return 404;
    }

    # ── Health (proxied directly, no /api prefix rewrite needed) ────────────
    location = /health {
        proxy_pass         $backend/health;
        proxy_http_version 1.1;
        access_log         off;
    }

    # ── API backend ──────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ── Frontend (Angular static — nginx serves SPA) ─────────────────────────
    location / {
        proxy_pass         $frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── Let's Encrypt ACME challenge ─────────────────────────────────────────
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
}
