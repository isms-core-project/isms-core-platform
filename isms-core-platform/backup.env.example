# ── ISMS CORE Volume Backup Configuration ────────────────────────────────────
# Copy to backup.env and adjust before starting the stack.
# Reference: https://offen.github.io/docker-volume-backup/
#
# Volumes backed up:
#   postgres-data   — all relational state (orgs, controls, compliance projects)
#   garage-meta     — Garage S3 metadata (only relevant with --profile garage)
#   garage-data     — Garage S3 data: evidence files + OpenSearch ISM snapshots
#
# Postgres is briefly stopped during backup (stop-during-backup label) to
# guarantee filesystem consistency. Typical pause: < 30 seconds.
#
# Schedule: 03:20 UTC daily — runs after the OpenSearch snapshot. The backup stops PostgreSQL for a few seconds, so the minute matters: the feed
# schedulers run in the containers' LOCAL time (Europe/Zurich: UTC+1 in winter, UTC+2 in summer) and start jobs at :00, :15, :30 and :45. 20 past the
# hour (UTC) is :20 local in both clock states, which no feed uses (checked against 60 days of feed_runs). The backup cron itself runs in UTC.
BACKUP_CRON_EXPRESSION=20 3 * * *

# Backup filename — Go time format
BACKUP_FILENAME=isms-backup-%Y-%m-%dT%H-%M-%S.tar.gz

# Compression: gz (fast, default) | zst (better ratio, requires zstd)
BACKUP_COMPRESSION=gz

# Delete local archives older than N days
BACKUP_RETENTION_DAYS=7

# Must match BACKUP_FILENAME prefix for pruning to work
BACKUP_PRUNING_PREFIX=isms-backup-

# ── Optional: remote destination (uncomment one block) ───────────────────────
#
# SSH/SFTP (e.g. a backup server):
# BACKUP_SSH_HOST_NAME=backup.example.com
# BACKUP_SSH_USER=backup
# BACKUP_SSH_REMOTE_PATH=/var/backups/isms-core
# BACKUP_SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
#
# S3-compatible (Backblaze B2, Wasabi, Cloudflare R2, etc.):
# AWS_S3_BUCKET_NAME=isms-core-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com   # omit for AWS S3
# AWS_S3_PATH=backups/
