# ============================================================================
# ISMS CORE Platform — Environment Variables
# Copy to .env and fill in ALL values before starting the stack.
# ⚠️  Do not use default values in production — change every line marked CHANGE
# ============================================================================

# ── Timezone ─────────────────────────────────────────────────────────────────
# Applied to all containers. Use IANA tz name (e.g. Europe/Paris, Europe/Berlin,
# America/New_York). Affects log timestamps, scheduled tasks, SM snapshot schedule.
TZ=Europe/Zurich

# ── Platform Images ────────────────────────────────────────────────────────────
# Pre-built images, no local build required — see docker-compose.yml.
# Default registry is GHCR (public).
# PLATFORM_TAG pins a specific release instead of always tracking latest.
PLATFORM_REGISTRY=ghcr.io/isms-core-project/isms-core-platform
PLATFORM_TAG=latest

# ── Deployment Mode ───────────────────────────────────────────────────────────
# COMPOSE_PROFILES tells Docker Compose which service groups to activate.
# It is read automatically from this file — no --profile CLI flags needed.
# Pick one line below, uncomment it, and `docker compose up -d` just works.
#
# Standard — single-node OpenSearch (recommended for most deployments):
COMPOSE_PROFILES=opensearch-single
#
# Standard + OSINT threat intelligence feeds (IOC Explorer, Malware Atlas, Threat Exposure):
# COMPOSE_PROFILES=opensearch-single,threat-intel     # ⚠ also set THREAT_INTEL_ENABLED=true below
#
# Standard + OpenSearch Dashboards UI on port 5601:
# COMPOSE_PROFILES=opensearch-single,dashboards
#
# Standard + Garage S3 (evidence files + snapshots, single-node):
# COMPOSE_PROFILES=opensearch-single,garage
#
# Standard + email (pick one):
# COMPOSE_PROFILES=opensearch-single,mailpit          # local dev mail catcher
# COMPOSE_PROFILES=opensearch-single,smtp-bridge      # Microsoft 365 / OAuth relay
#
# Standard + automated volume backup (configure backup.env first, create /var/backups/isms-core):
# COMPOSE_PROFILES=opensearch-single,backup
#
# Full standard stack (all optional modules):
# COMPOSE_PROFILES=opensearch-single,threat-intel,dashboards,smtp-bridge,backup  # ⚠ also set THREAT_INTEL_ENABLED=true
#
# Enterprise — 3-node OpenSearch cluster + Garage S3 + Dashboards + Threat Intel + SMTP + Backup:
# COMPOSE_PROFILES=opensearch-cluster,garage,dashboards,threat-intel,smtp-bridge,backup  # ⚠ also set THREAT_INTEL_ENABLED=true
#
# ⚠️  opensearch-single and opensearch-cluster are mutually exclusive.
#     Always include exactly one. Never both.

# ---- Content paths -------------------------------------------------------
# Host-side paths to the policy/IMP source directories mounted into the backend.
# Defaults (used when unset) expect the standard production folder layout where
# the promoted content lives one level up from this repo (../isms-core-framework etc.).
# On a developer workstation the numbered working dirs are used instead.
#
# Production stack (default — leave commented out or keep these values):
# FRAMEWORK_HOST_PATH=../isms-core-framework
# OPERATIONAL_HOST_PATH=../isms-core-operational
# PRIVACY_HOST_PATH=../isms-core-privacy
# CLOUD_HOST_PATH=../isms-core-cloud
# AI_HOST_PATH=../isms-core-ai
#
# Local dev example (adjust to your actual paths):
# FRAMEWORK_HOST_PATH=../isms-core-framework
# OPERATIONAL_HOST_PATH=../isms-core-operational
# PRIVACY_HOST_PATH=../isms-core-privacy
# CLOUD_HOST_PATH=../isms-core-cloud
# AI_HOST_PATH=../isms-core-ai
#
# Note: ISO reference corpus is baked into the image (datasets/data/iso-reference/).
# No mount needed. To update seeds: run datasets/extract_iso_seeds.py then rebuild.

# ---- Host ----------------------------------------------------------------
# Set HOST_IP to your server's IP address (or hostname)
# This is used for the nginx self-signed cert SAN + frontend API URL
HOST_IP=YOUR_SERVER_IP                        # CHANGE — e.g. 192.168.1.100

# FQDN: set this if using Let's Encrypt (must have certbot + port 80 public)
# Leave empty to use self-signed certificate (auto-generated on first boot — works anywhere)
FQDN=

PLATFORM_URL=https://YOUR_SERVER_IP           # CHANGE — match HOST_IP above
CORS_ORIGINS=https://YOUR_SERVER_IP           # CHANGE — match HOST_IP above

# Set COOKIE_SECURE=false only for local HTTP development (no HTTPS)
COOKIE_SECURE=true

# ---- Secrets (CHANGE ALL OF THESE) --------------------------------------
POSTGRES_PASSWORD=change_this_db_password
REDIS_PASSWORD=change_this_redis_password
# Encrypt the connection to Redis (broker, task results). Default false: Redis is only reachable on the private Docker network. Set true on an
# install whose services are spread over several hosts. The certificate comes from the platform's own CA (the same one OpenSearch uses) and the
# services verify it. To switch: set REDIS_TLS=true, then `docker compose up -d --force-recreate isms-core-redis isms-core-backend isms-core-worker isms-core-beat`
# (the data is kept). Running with the old plain setting on some services and TLS on others does not work: change all together.
REDIS_TLS=false

# Used as PBKDF2-HMAC-SHA256 input for connector config encryption (NIST SP 800-132).
# MUST be a cryptographically random value — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret_key_minimum_32_chars

# ---- Admin account -------------------------------------------------------
# ADMIN_EMAIL: bootstrap admin identity seeded into the DB on first run.
# May be a dummy address — use NOTIFICATION_EMAIL for real alert delivery.
ADMIN_EMAIL=admin@isms-core.dev
# ADMIN_PASSWORD: REQUIRED — platform refuses to start if blank or < 12 chars.
# No default exists. Generate a strong value with a password manager.
ADMIN_PASSWORD=

# ---- Connectors ----------------------------------------------------------
# Shared secret authenticating connector workers and feed containers to the backend API.
# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CONNECTORS_WORKER_SECRET=
# Separate secrets for the feeds container and the threat-intel container (backend <-> container trigger calls and failure callbacks).
# Recommended: set both, each to its own value (same generator as above), so a compromised feeds / threat-intel container does not
# hold the secret that unlocks the connectors' stored credentials. Leave empty and the shared CONNECTORS_WORKER_SECRET is used.
FEEDS_TRIGGER_SECRET=
TI_TRIGGER_SECRET=

# ---- Third-party API keys in the WebUI ------------------------------------
# Admin -> API keys (Super Admin) stores the third-party keys (NVD, VulnCheck, the threat-intel feeds, Anthropic) encrypted in the database, each
# with its own Enabled switch. NEW installations: leave the key variables further down EMPTY and enter the keys in the WebUI. EXISTING installations:
# keys already set below are moved into the WebUI once, automatically, at the first start with this secret set (enabled; nothing to retype); after
# that the WebUI is the source of truth and the lines below are only a fallback you can delete. A key saved there wins while its switch is on.
# The WebUI needs this secret to encrypt the keys (backend, feeds and threat-intel get it; never SECRET_KEY). At least 32 random characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it later makes the stored keys unreadable (the environment fallback then applies) — re-enter them in the WebUI.
PLATFORM_KEY_ENCRYPTION_SECRET=
# Optional tuning (defaults shown):
# RUNNER_REFRESH_INTERVAL=15      # seconds between connector list refresh
# POLL_INTERVAL=86400              # seconds between each connector's sync (24h)

# Self-signed/internal-CA certificates for connectors are trusted in the
# WebUI: open the connector's Configure dialog, click "Fetch Certificate",
# compare the fingerprint with the server, then "Trust this certificate".
# Trust is per connector instance and covers exactly that one certificate —
# never a blanket *_VERIFY_SSL=false. After a certificate rotation, fetch it
# again and re-trust; the connector restarts with the new pin automatically.
# .env.connector-certs remains supported as a headless fallback for
# deployments that pre-provision trust from the shell.

# ---- AI (optional) -------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Email (choose one profile or leave MAIL_HOST blank to disable) ------
# Leave MAIL_HOST blank to disable email (default — safe for prod with no email configured)
#
# Mailpit (dev mail catcher — never use in prod):
#   docker compose --profile mailpit up -d
#   MAIL_HOST=isms-core-mailpit
#
# SMTP Bridge (M365 / Exchange Online relay — prod email):
#   docker compose --profile smtp-bridge up -d
#   MAIL_HOST=isms-core-smtp-bridge
MAIL_HOST=
MAIL_PORT=1025
# Required when MAIL_HOST=isms-core-smtp-bridge — the bridge requires SMTP
# AUTH to prevent unauthenticated relay of mail through your M365 identity.
# Leave blank for mailpit/unauthenticated relays — the backend simply won't
# attempt AUTH.
MAIL_USERNAME=
MAIL_PASSWORD=
# Send mail only over verified TLS (STARTTLS, or implicit TLS on port 465). Default false: the bundled smtp-bridge and plain internal relays
# have no TLS. Set true for an external or internet-facing relay. A relay that offers no TLS is then refused, never used in clear text.
# MAIL_CA_FILE: path (inside the container) of a PEM file with your private CA or the relay's certificate, if it is not publicly trusted.
MAIL_REQUIRE_TLS=false
MAIL_CA_FILE=
# NOTIFICATION_EMAIL: controls outbound notification delivery in two ways:
#   1. SUBSTITUTE — if a DB admin's email is the dummy ADMIN_EMAIL address
#      (admin@isms-core.dev), it is replaced by this address before sending.
#      No duplicate sends; this is substitution, not addition.
#   2. ALWAYS-INCLUDE — for infrastructure events (feed/connector failures, QA
#      checks) this address is appended to the recipient list so at least one
#      guaranteed delivery happens even if all DB admin accounts use dummy emails.
# Leave blank to rely entirely on DB user email addresses.
NOTIFICATION_EMAIL=

# SMTP Bridge credentials (only needed with --profile smtp-bridge)
SMTP_BRIDGE_TENANT_ID=
SMTP_BRIDGE_CLIENT_ID=
SMTP_BRIDGE_CLIENT_SECRET=
SMTP_BRIDGE_FROM_ADDRESS=
SMTP_BRIDGE_FROM_NAME=ISMS CORE
# Comma-separated recipient domain allow-list (e.g. corp.local,partner.com).
# Without this set, an authenticated caller can relay to ANY recipient using
# the org's real M365 identity (BEC risk). Leave blank only if you understand
# and accept that.
SMTP_BRIDGE_ALLOWED_DOMAINS=
# SMTP AUTH credentials the bridge requires from callers, to prevent
# unauthenticated relay through your M365 identity. Defaults to
# MAIL_USERNAME/MAIL_PASSWORD above so one credential pair configures both
# the backend/worker/beat services and the bridge. With MAIL_HOST=isms-core-smtp-bridge
# the backend presents MAIL_USERNAME/MAIL_PASSWORD to the bridge, so they ARE the bridge
# credential: use a value generated for this purpose (never a real mailbox password), and
# leave these two empty. If you set them, set MAIL_USERNAME/MAIL_PASSWORD to the same
# values, otherwise the backend cannot authenticate to the bridge and mail stops.
SMTP_BRIDGE_USERNAME=
SMTP_BRIDGE_PASSWORD=

# ── Threat Intelligence & Vulnerability Feeds ────────────────────────────────
# Admin override: force every enabled feed to run immediately on EVERY container
# start/recreate, not just the first one. Leave false — the scheduler already
# auto-seeds any feed that has never had a successful run (feeds/scheduler.py
# _should_run()), so this flag is normally never needed. Only flip true for a
# one-off manual reseed, then flip back — leaving it true means a slow feed
# (NVD CVE full pull: ~250K entries, 45-75min) re-runs on every restart/redeploy.
FEEDS_RUN_ON_START=false

# Core intelligence feeds (no API key required)
FEEDS_MITRE_ENABLED=true
FEEDS_ATLAS_ENABLED=true
FEEDS_KEV_ENABLED=true
FEEDS_EPSS_ENABLED=true

# NVD CVE/CPE feeds — require OpenSearch; CVE feed indexes ~250K entries on first full run
FEEDS_CVE_ENABLED=false
# CPE Option B: additionally query NVD CPE API for KEV vendor/product names (~3-5K extra CPEs)
FEEDS_CPE_FULL=false
# NIST NVD API key — optional, raises rate limit from 5→50 req/30s (register free at nvd.nist.gov)
NIST_API_KEY=

# ENISA EUVD feed — EU vulnerability database (NIS2/CRA mandate); no API key required
FEEDS_EUVD_ENABLED=true

# Exploit-DB feed — public exploit/PoC database (~52K entries, cross-references CVEs); no API key required
# Source: https://gitlab.com/exploit-database/exploitdb (GPL v2); daily 04:30 UTC
FEEDS_EXPLOITDB_ENABLED=true

# VulnCheck feed — faster/broader exploit-intel than CISA KEV alone; requires VULNCHECK_API_KEY below
FEEDS_VULNCHECK_ENABLED=true

# ── Threat Intelligence (--profile threat-intel) ─────────────────
# Start with:  docker compose --profile threat-intel up -d
# Must also set THREAT_INTEL_ENABLED=true so the backend exposes the TI menu.
#
# Frontend menu items (IOC Explorer, Malware Atlas, IP Enrichment) are always
# visible but greyed out when this is false. Set true once the profile is active.
THREAT_INTEL_ENABLED=false

# Individual source toggles (all default true when profile is active)
TI_MISP_CIRCL_ENABLED=true
TI_MISP_BOTVRIJ_ENABLED=true
TI_ABUSEIPDB_ENABLED=true
TI_URLHAUS_ENABLED=true
TI_THREATFOX_ENABLED=true
TI_SSLBL_ENABLED=true
TI_FEODOTRACKER_ENABLED=true
TI_RED_FLAG_DOMAINS_ENABLED=true
TI_STOPFORUMSPAM_ENABLED=true
TI_MALWAREBAZAAR_ENABLED=true
TI_ALIENVAULT_ENABLED=true
TI_VIRUSTOTAL_ENABLED=true
TI_MALPEDIA_ENABLED=true

# MISP history depth — applied only on first run; subsequent runs use UUID delta.
# Default 2024-01-01 gives a fast initial import (~2 years of events).
# Set 2000-01-01 to import the full CIRCL/Botvrij archive (slow first run).
TI_MISP_IMPORT_FROM_DATE=2024-01-01

# Force-run all TI feeds on every container start (default false — use first-boot seeding)
TI_RUN_ON_START=false

# API keys — leave blank to disable that source
# AbuseIPDB: https://www.abuseipdb.com/api  (free tier: 1,000 check calls/day)
ABUSEIPDB_API_KEY=
# Shodan: https://account.shodan.io  (optional — InternetDB free fallback is always used)
SHODAN_API_KEY=
# Malpedia: the feed uses the public API without a key (MALPEDIA_API_KEY is not read by any code and can be removed).
MALPEDIA_API_KEY=
# ThreatFox: https://threatfox.abuse.ch/api/  (free registration — required for get_iocs)
THREATFOX_API_KEY=
# MalwareBazaar: https://bazaar.abuse.ch/api/  (free registration — required)
MALWAREBAZAAR_API_KEY=
# AlienVault OTX: https://otx.alienvault.com  (free registration — required)
OTX_API_KEY=
# OTX first-run import depth in days (default 90).
# ⚠ WARNING: increasing this significantly (e.g. 365) pulls a very large number
# of pulses and may take hours on first run. Delta runs always use 2 days.
OTX_IMPORT_DAYS=90
# VirusTotal: https://virustotal.com  (free registration — required for enrichment)
# Free tier: 4 req/min, 500 req/day. Enriches up to 450 IOCs/day (VT_DAILY_LIMIT).
VT_API_KEY=
# VT_DAILY_LIMIT=450
# MaxMind GeoLite2 City web service — IP geo enrichment (country, city, ASN)
# Register free at https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# IPInfo — IP privacy enrichment (VPN/proxy/Tor/hosting detection)
# Register at https://ipinfo.io/signup
IPINFO_API_KEY=
# VulnCheck — exploit/KEV intelligence, faster/broader than CISA KEV alone
# Free Community account: https://vulncheck.com  (free tier: 1,000 req/min)
VULNCHECK_API_KEY=
# GreyNoise — internet-noise/scanner context, cuts down false-positive alerting
# Free Community account: https://greynoise.io  (free tier: 50 searches/week —
# requires a business email; free webmail addresses don't get API-key-level access)
GREYNOISE_API_KEY=

# ── Enterprise — OpenSearch ──────────────────────────────────────────────────
# Heap size per node (single-node or each cluster node). Default: 1g
# For a 3-node cluster on a 32 GB host: 4g per node (3×4=12 GB total)
OPENSEARCH_HEAP=1g

# ############################################################################
# #  !!  QUICK-START DEFAULT — LOCAL EVALUATION ONLY  !!                     #
# #  Before ANY real use switch OpenSearch security on — the block below     #
# #  says exactly which lines to change.                                     #
# ############################################################################
# true is the quick-start default: OpenSearch has NO authentication and NO
# TLS, and any container on isms-core-network can read/write every index
# (evidence, audit trail, threat intel) with a plain curl.
# false turns on the security plugin: HTTPS everywhere (REST and node-to-node,
# real per-deployment certificates from the platform's own CA, generated by
# isms-core-internal-certs-init), a login for every request, and OpenSearch
# Dashboards served over HTTPS with its own login.
#
# TO ENABLE (all of these together; then recreate the OpenSearch stack — turning
# security on or off needs a full restart of the cluster, not a rolling one):
#   OPENSEARCH_DISABLE_SECURITY=false
#   OPENSEARCH_ADMIN_PASSWORD=<strong password>
#   OPENSEARCH_DASHBOARDS_PASSWORD=<another one>      (only with the dashboards profile)
#   OPENSEARCH_URL=https://isms-core-opensearch:9200
#   OPENSEARCH_USERNAME=admin
#   OPENSEARCH_PASSWORD=<same value as OPENSEARCH_ADMIN_PASSWORD>
#   OPENSEARCH_USE_SSL=true
#   OPENSEARCH_VERIFY_CERTS=true
# Use passwords without a dollar sign ($): .env treats it as a variable reference.
# Existing indices keep their data. The initial passwords are read ONCE, when the
# security plugin first initialises; later changes go through its API (or wipe
# the opensearch data volume to start over).
OPENSEARCH_DISABLE_SECURITY=true

# Password of the built-in "admin" user. Required when OPENSEARCH_DISABLE_SECURITY=false.
OPENSEARCH_ADMIN_PASSWORD=
# Password of the OpenSearch Dashboards server account ("kibanaserver"). Required for
# --profile dashboards when security is on. The security plugin's other demo accounts
# (with public, well-known passwords) are NOT created on this platform.
OPENSEARCH_DASHBOARDS_PASSWORD=
# Names or addresses people type in the browser to reach Dashboards (https://<this>:5601),
# added to its certificate, e.g. DNS:isms.example.com,IP:192.0.2.10. The platform's
# CA certificate (the "opensearch-ca" folder of the isms-core-internal-certs volume,
# file ca.crt) has to be trusted by the browser to remove the certificate warning.
DASHBOARDS_TLS_EXTRA_SAN=

# Where the backend, workers, feeds and set-up jobs find OpenSearch, and the login they use.
# Leave USERNAME/PASSWORD empty while the security plugin is disabled.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Client-side TLS to OpenSearch. An https:// OPENSEARCH_URL switches TLS on by itself, and the client then checks the certificate (and its name)
# against OPENSEARCH_CA_CERT, which defaults to the platform's own CA in the shared certs volume. OPENSEARCH_VERIFY_CERTS is kept for
# older .env files; it no longer decides anything while TLS is on.
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# With TLS on, the certificate is ALWAYS checked. Only for an external OpenSearch with a certificate you cannot trust properly: set true to skip the
# check (logged; connections can then be intercepted).
OPENSEARCH_ALLOW_UNVERIFIED_TLS=false
# Leave unset to use the platform's own CA; set only to trust a different one (a path inside the container).
OPENSEARCH_CA_CERT=

# ── Postgres TLS ──────────────────────────────────────────────────────────────
# verify-full (default) encrypts and verifies the server certificate against
# DB_SSL_ROOT_CERT, refusing to connect at all if that cert is missing — the
# isms-core-internal-certs-init service generates it automatically on first
# boot. Set to "require" to encrypt without verifying, or "disable" for
# plaintext (not recommended). See ALLOW_UNVERIFIED_INTERNAL_TLS below for
# the explicit, logged opt-out if the cert is ever genuinely unavailable.
DB_SSLMODE=verify-full
# Path to the CA cert file (mounted into the container) used to verify the
# server with DB_SSLMODE=verify-full/verify-ca.
DB_SSL_ROOT_CERT=/certs/postgres/server.crt
# Explicit, logged opt-out: connect to Postgres without verifying its
# certificate if DB_SSL_ROOT_CERT is missing, instead of refusing to start.
# Leave unset/false unless you know why you need it.
ALLOW_UNVERIFIED_INTERNAL_TLS=false

# ── Enterprise — Garage S3 (--profile garage) ────────────────────────────────
# S3 endpoint — the HTTPS name of the TLS proxy in front of Garage (Garage itself cannot do TLS and is only reachable through this proxy).
# Changing an existing install from the old plain-HTTP value (http://isms-core-garage:3900): set this to the value below, or delete the line.
GARAGE_ENDPOINT=https://isms-core-garage-tls:3900

# RPC cluster secret — generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_generate_with_openssl_rand_hex_32

# Admin token — generate with: openssl rand -hex 32
# Read directly by Garage itself via this env var (GARAGE_ADMIN_TOKEN is a
# supported override per Garage's own docs — nothing to change in
# garage/garage.toml, that file never contains a real secret). The admin API
# (port 3903) is reachable by every container on isms-core-network through the
# HTTPS proxy in front of Garage, so an unchanged placeholder here is a
# known-token admin bypass for the S3 store.
GARAGE_ADMIN_TOKEN=CHANGE_generate_with_openssl_rand_hex_32

# Access key imported by setup.py on first boot.
# Both must be hex. Generate with:
#   python3 -c "import secrets; print('ACCESS: GK'+secrets.token_hex(12)); print('SECRET:', secrets.token_hex(32))"
# Key ID:     GK + exactly 24 hex chars
# Secret key: exactly 64 hex chars (32 bytes)
GARAGE_ACCESS_KEY=CHANGE_run_generation_command_above
GARAGE_SECRET_KEY=CHANGE_run_generation_command_above

# Bucket names (defaults match the isms-core-garage-setup init container — change only if needed)
GARAGE_BUCKET_EVIDENCE=isms-evidence
GARAGE_BUCKET_SNAPSHOTS=isms-snapshots
GARAGE_BUCKET_EXPORTS=isms-exports

# ── Volume Backup ────────────────────────────────────────────────────────────
# Host directory where daily backup archives are stored.
# Must exist before starting the stack — create with:
#   sudo mkdir -p /var/backups/isms-core
# See backup.env.example for schedule / retention / remote destination config.
BACKUP_ARCHIVE_PATH=/var/backups/isms-core

# ── Evidence Storage Backend ─────────────────────────────────────────────────
# postgres = all evidence in PostgreSQL (default — recommended)
# opensearch = evidence in OpenSearch, files in Garage S3 (requires --profile garage + opensearch-cluster)
EVIDENCE_STORE=postgres

# ── Port exposure (bind address) ─────────────────────────────────────────────
# 127.0.0.1 = localhost only (default — not reachable from LAN)
# 0.0.0.0   = expose on all interfaces (reachable from LAN / VPN)
# Set to your server IP (e.g. 192.0.2.10) to expose on a specific interface only.
#
# Garage S3 API (port 3900) — keep 127.0.0.1 unless you need external S3 access
GARAGE_BIND=127.0.0.1
#
# OpenSearch Dashboards (port 5601) — set to 0.0.0.0 to access from browser on LAN
DASHBOARDS_BIND=127.0.0.1
#
# Mailpit web UI (port 8025) — dev only, keep localhost
MAILPIT_BIND=127.0.0.1
