# ============================================================================
# ISMS CORE Platform — Environment Variables
# Copy to .env and fill in ALL values before starting the stack.
# ⚠️  Do not use default values in production — change every line marked CHANGE
# ============================================================================

# ---- Content paths -------------------------------------------------------
# Host-side paths to the policy/IMP source directories mounted into the backend.
# Defaults (used when unset) expect the standard production folder layout where
# the promoted content lives one level up from this repo (../isms-core-framework etc.).
# On a developer workstation the numbered working dirs are used instead.
#
# Production (default — leave commented out or keep these values):
# FRAMEWORK_HOST_PATH=../isms-core-framework
# OPERATIONAL_HOST_PATH=../isms-core-operational
# PRIVACY_HOST_PATH=../isms-core-privacy
# CLOUD_HOST_PATH=../isms-core-cloud
#
# Local dev example (adjust to your actual paths):
# FRAMEWORK_HOST_PATH=../50-isms-core-framework
# OPERATIONAL_HOST_PATH=../10-isms-core-operational
# PRIVACY_HOST_PATH=../51-isms-core-privacy
# CLOUD_HOST_PATH=../52-isms-core-cloud
#
# Note: ISO reference corpus is baked into the image (datasets/data/iso-reference/).
# No mount needed. To update seeds: run datasets/extract_iso_seeds.py then rebuild.

# ---- Host ----------------------------------------------------------------
# Set HOST_IP to your server's IP address (or hostname)
# This is used for the nginx self-signed cert SAN + frontend API URL
HOST_IP=YOUR_SERVER_IP                        # CHANGE — e.g. 192.168.1.100

# FQDN: set this if using Let's Encrypt (must have certbot + port 80 public)
# Leave empty to use self-signed certificate (auto-generated on first boot — works anywhere)
FQDN=

PLATFORM_URL=https://YOUR_SERVER_IP           # CHANGE — match HOST_IP above
CORS_ORIGINS=https://YOUR_SERVER_IP           # CHANGE — match HOST_IP above

# ---- Secrets (CHANGE ALL OF THESE) --------------------------------------
POSTGRES_PASSWORD=change_this_db_password
REDIS_PASSWORD=change_this_redis_password

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_secret_key_minimum_32_chars

# ---- Admin account -------------------------------------------------------
# Created/updated on every backend startup
ADMIN_EMAIL=admin@isms-core.dev
ADMIN_PASSWORD=change_this_admin_password

# ---- Connectors ----------------------------------------------------------
# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CONNECTORS_WORKER_SECRET=
# Optional tuning (defaults shown):
# RUNNER_REFRESH_INTERVAL=60      # seconds between connector list refresh
# POLL_INTERVAL=86400              # seconds between each connector's sync (24h)

# ---- AI (optional) -------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Email (choose one profile or leave MAIL_HOST blank to disable) ------
# Leave MAIL_HOST blank to disable email (default — safe for prod with no email configured)
#
# Mailpit (dev mail catcher — never use in prod):
#   docker compose --profile mailpit up -d
#   MAIL_HOST=isms-core-mailpit
#
# SMTP Bridge (M365 / Exchange Online relay — prod email):
#   docker compose --profile smtp-bridge up -d
#   MAIL_HOST=isms-core-smtp-bridge
MAIL_HOST=
MAIL_PORT=1025
# Override the default notification recipient (defaults to admin_email if blank)
NOTIFICATION_EMAIL=

# SMTP Bridge credentials (only needed with --profile smtp-bridge)
SMTP_BRIDGE_TENANT_ID=
SMTP_BRIDGE_CLIENT_ID=
SMTP_BRIDGE_CLIENT_SECRET=
SMTP_BRIDGE_FROM_ADDRESS=
SMTP_BRIDGE_FROM_NAME=ISMS CORE

# ── Phase 25: Threat Intelligence & Vulnerability Feeds ──────────────────────
# NIST NVD API key — required for CVE/CPE feeds (register at nvd.nist.gov/developers/request-an-api-key)
NIST_API_KEY=

# Run all enabled feeds immediately on container start (set false after initial seeding if desired)
FEEDS_RUN_ON_START=true

# Feed toggles (Phase 1 feeds work without NIST_API_KEY)
FEEDS_MITRE_ENABLED=true
FEEDS_ATLAS_ENABLED=true
FEEDS_KEV_ENABLED=true
FEEDS_EPSS_ENABLED=true

# Phase 27 — NVD CVE/CPE feeds (requires OpenSearch, set FEEDS_CVE_ENABLED=true to activate)
FEEDS_CVE_ENABLED=false
# CPE Option B: additionally query NVD CPE API for KEV vendor/product names (~3-5K extra CPEs)
FEEDS_CPE_FULL=false
# NIST NVD API key — optional, raises rate limit from 5→50 req/30s (register free at nvd.nist.gov)
NIST_API_KEY=

# Set true when ATT&CK v19 is officially released to label new pulls as attack_v19
FEEDS_MITRE_V19=false
