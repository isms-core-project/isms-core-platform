# Environment — never commit secrets
.env
.env.local
.env.*.local
.env.connector-certs
backup.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# Node
node_modules/
frontend/dist/
frontend/.angular/

# Docker volumes (local only)
postgres-data/
redis-data/
opensearch-data/
certs/

# Uploads / generated
backend/uploads/
backend/cache/

# IDE
.DS_Store
.idea/
*.swp

# Security-scan output — never commit (reports contain exploit detail)
*/security-scan/
# The integrations leg of the security scan writes its report directly into this folder (not one level down), which the
# pattern above does not match — reports contain exploit detail and must never be committed.
/security-scan/
*/security-remediation/

# The scan tool injects its own scaffolding folder into the scanned tree (backend/<tool folder>/):
# not our code, same treatment as security-scan/ above.
*/.vvaharness/

# Celery beat's pickle-based schedule file — never commit (CWE-502, deserialization RCE risk)
backend/celerybeat-schedule*
