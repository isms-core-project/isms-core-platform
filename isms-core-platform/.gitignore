# Environment — never commit secrets
.env
.env.local
.env.*.local
.env.connector-certs
backup.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# Node
node_modules/
frontend/dist/
frontend/.angular/

# Docker volumes (local only)
postgres-data/
redis-data/
opensearch-data/
certs/

# Uploads / generated
backend/uploads/
backend/cache/

# IDE
.DS_Store
.idea/
*.swp

# VVAH scan output (93-isms-core-vvah/run-scan.sh writes here) — never commit exploit detail
*/security-scan/
# The integrations leg of the security scan writes its report directly into this folder (not one level down), which the
# pattern above does not match — reports contain exploit detail and must never be committed.
/security-scan/
*/security-remediation/

# vvaharness v1.5.0 (2026-10-10) injects its 17 detection skills directly into the scanned
# target's own tree (e.g. backend/.vvaharness/skills/) — scan-tool scaffolding, not our code,
# same treatment as security-scan/ above.
*/.vvaharness/

# VVAH finding #21 — pickle-based Celery beat schedule, never commit (CWE-502 deserialization RCE risk)
backend/celerybeat-schedule*
